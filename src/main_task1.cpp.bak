// Сутінковий перемикач на ESP32-S3.
// Модуль реле: HW-307 (реле Songle JQC3F-05VDC-C, котушка ~70 Ом / ~70 мА).
//
// Дільник LDR -> ADC -> гістерезис -> транзисторний ключ -> модуль реле.
//
// Схема:
//   +3.3V --- [LDR] ---+--- [10 кОм] --- GND
//                      |
//                   GPIO4 (ADC1_CH3)
//
//   GPIO21 --- [10 кОм] --- база VT1 (BC547B, емітер на GND)
//   колектор VT1 --- IN модуля реле,  і через [10 кОм] на +5V
//
// ВАЖЛИВО, два рази перевір перед запуском:
//
//  1. ADC лише на ADC1 = GPIO1..GPIO10. ADC2 (GPIO11..20) займає радіостек
//     ("ADC2 is also used by Wi-Fi" у документації Espressif), читання звідти
//     може повернути таймаут замість значення.
//
//  2. Транзисторний ключ ІНВЕРТУЄ: GPIO=HIGH -> транзистор насичений ->
//     на IN реле ≈0 В. Код нижче писаний під модуль реле active-LOW
//     (увімкнення нулем) — так зроблена більшість дешевих модулів з
//     оптопарою. Перевірка: тицни IN на GND; клацнуло — модуль active-LOW,
//     все правильно. Якщо твій модуль active-HIGH, поміняй RELAY_ON/OFF.

#include <Arduino.h>

// ---------- Піни ----------
constexpr uint8_t LDR_PIN   = 4;    // ADC1_CH3
constexpr uint8_t RELAY_PIN = 21;   // на базу транзистора через 10 кОм

// Рівні на GPIO, які вмикають/вимикають навантаження.
// Ключ інвертує, модуль active-LOW -> разом виходить пряма логіка.
constexpr uint8_t RELAY_ON  = HIGH;
constexpr uint8_t RELAY_OFF = LOW;

// ---------- Пороги: ЗАПОВНИТИ ЗА РЕЗУЛЬТАТАМИ КАЛІБРУВАННЯ ----------
// Запусти режим калібрування (команда 'c'), накрий і відкрий датчик,
// подивись на min/max і підставь свої числа.
constexpr uint16_t THRESHOLD_DARK  = 800;   // нижче цього — темно, вмикаємо
constexpr uint16_t THRESHOLD_LIGHT = 1400;   // вище цього — світло, вимикаємо

// Гістерезис має сенс лише якщо поріг вимкнення ВИЩЕ порога ввімкнення.
// Переплутаєш місцями — реле почне тріщати. Ловимо це ще на компіляції.
static_assert(THRESHOLD_LIGHT > THRESHOLD_DARK,
              "THRESHOLD_LIGHT має бути більшим за THRESHOLD_DARK");

// ---------- Таймінги ----------
constexpr uint32_t CONFIRM_MS = 2000;   // умова має триматись стільки, щоб перемкнути
constexpr uint32_t SAMPLE_MS  = 100;    // як часто міряємо
constexpr uint8_t  AVG_N      = 32;     // скільки замірів усереднюємо

enum AppMode : uint8_t { MODE_RUN, MODE_CALIBRATE };
AppMode appMode = MODE_RUN;

bool relayOn = false;

// Межі, помічені під час калібрування
uint16_t seenMin = UINT16_MAX;
uint16_t seenMax = 0;

// Усереднене читання: один відлік ADC на ESP32 стрибає на десятки одиниць
static uint16_t readLdr() {
  uint32_t sum = 0;
  for (uint8_t i = 0; i < AVG_N; i++) {
    sum += analogRead(LDR_PIN);
    delayMicroseconds(200);
  }
  return (uint16_t)(sum / AVG_N);
}

static void setRelay(bool on) {
  relayOn = on;
  digitalWrite(RELAY_PIN, on ? RELAY_ON : RELAY_OFF);
  Serial.printf(">>> Навантаження %s\n", on ? "УВІМКНЕНО" : "вимкнено");
}

static void printHelp() {
  Serial.println();
  Serial.println("Команди: 'c' — калібрування | 'r' — робочий режим | '?' — довідка");
  Serial.printf("Пороги в прошивці: темно < %u, світло > %u (мертва зона %u відліків)\n",
                THRESHOLD_DARK, THRESHOLD_LIGHT,
                (unsigned)(THRESHOLD_LIGHT - THRESHOLD_DARK));
}

void setup() {
  Serial.begin(115200);
  delay(300);

  pinMode(RELAY_PIN, OUTPUT);
  digitalWrite(RELAY_PIN, RELAY_OFF);   // стартуємо з вимкненим навантаженням

  // analogRead за замовчуванням дає 12 біт (0..4095) — саме той діапазон,
  // що в умові завдання. Явно, щоб не залежати від змін у ядрі.
  analogReadResolution(12);

  Serial.println("Сутінковий перемикач, ESP32-S3");
  printHelp();
}

void loop() {
  static uint32_t lastSample = 0;

  // ---- команди з термінала ----
  if (Serial.available()) {
    const char c = (char)Serial.read();
    if (c == 'c' || c == 'C') {
      appMode = MODE_CALIBRATE;
      seenMin = UINT16_MAX;
      seenMax = 0;
      setRelay(false);
      Serial.println("\n=== КАЛІБРУВАННЯ ===");
      Serial.println("Накрий датчик рукою, потім піднеси до лампи, потім лиши як у кімнаті.");
      Serial.println("Записуй значення для: яскраве світло / кімната / сутінки / долоня.");
    } else if (c == 'r' || c == 'R') {
      appMode = MODE_RUN;
      Serial.println("\n=== РОБОЧИЙ РЕЖИМ ===");
    } else if (c == '?') {
      printHelp();
    }
  }

  if (millis() - lastSample < SAMPLE_MS) return;
  lastSample = millis();

  const uint16_t raw = readLdr();

  // ---- режим калібрування: тільки міряємо й показуємо ----
  if (appMode == MODE_CALIBRATE) {
    if (raw < seenMin) seenMin = raw;
    if (raw > seenMax) seenMax = raw;

    static uint8_t tick = 0;
    if (++tick >= 3) {    // друкуємо ~3 рази на секунду, а не 10
      tick = 0;
      Serial.printf("ADC %4u | %4u мВ | бачив min %4u  max %4u",
                    raw, analogReadMilliVolts(LDR_PIN), seenMin, seenMax);
      if (seenMax > seenMin + 100) {
        const uint16_t span = seenMax - seenMin;
        Serial.printf("  ->  спробуй DARK %u / LIGHT %u",
                      (uint16_t)(seenMin + span * 30 / 100),
                      (uint16_t)(seenMin + span * 50 / 100));
      }
      Serial.println();
    }
    return;
  }

  // ---- робочий режим: гістерезис + підтвердження часом ----
  //
  // Поріг залежить від поточного стану: увімкнене реле відпускає не там,
  // де схоплює. Між порогами не робимо нічого — це мертва зона.
  int8_t want = 0;
  if (!relayOn && raw < THRESHOLD_DARK)  want = +1;   // стемніло -> увімкнути
  if ( relayOn && raw > THRESHOLD_LIGHT) want = -1;   // розвиднілось -> вимкнути

  // Умова має протриматись CONFIRM_MS, інакше тінь від людини або фари
  // машини клацатимуть реле. Саме так роблять справжні сутінкові реле.
  static int8_t  pending = 0;
  static uint32_t pendingSince = 0;

  if (want != pending) {
    pending = want;
    pendingSince = millis();
    if (want != 0) {
      Serial.printf("ADC %4u — умова %s, тримаю %lu мс...\n",
                    raw, want > 0 ? "ТЕМНО" : "СВІТЛО", (unsigned long)CONFIRM_MS);
    }
  } else if (pending != 0 && millis() - pendingSince >= CONFIRM_MS) {
    setRelay(pending > 0);
    pending = 0;
  }
}
