#include <Arduino.h>
#include <stdlib.h>

const int LED1 = 4;
const int LED2 = 5;
int counter = 0;

int random_range(int min, int max) {
    return rand() % (max - min + 1) + min;
}

void setup() {
  pinMode(LED1, OUTPUT);
  pinMode(LED2, OUTPUT);
  srand(time(NULL));
}

void changeState(int RED, int BLUE, int timeout = 100) {
  digitalWrite(LED1, RED);
  digitalWrite(LED2, BLUE);
  delay(timeout);
}

void loop() {
  if (counter % 3 == 0) {
    int currentCount = random_range(1, 10);
    for (int i = 0; i < currentCount; i++) {
      changeState(HIGH, LOW);
      changeState(LOW, HIGH);
    }
  }
  changeState(HIGH, LOW, 500);
  changeState(LOW, HIGH, 500);
  counter++;
}
